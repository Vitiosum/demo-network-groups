# The lobby (public app)
PORT=8080
# The vault's member name inside the Network Group: `clever ng get <vault app id> -F json` → domainName
VAULT_URL=http://app_xxx.m.ng_xxx.cc-ng.cloud:9000
# The vault's default public domain (answered by Clever's block service)
VAULT_PUBLIC_URL=https://app-xxx.cleverapps.io

# The vault (private app), set with clever env set ... --alias vault
# CC_REQUEST_FLOW=block
# PORT=9000
# CC_RUN_COMMAND=bun src/vault.ts
